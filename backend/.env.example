NODE_ENV=development
PORT=3000
JSON_STORAGE_PATH=./data/ai-business-analyst.json
JWT_SECRET=replace-me
# Optional one-time first-admin claim secret (at least 32 characters). Remove after bootstrap.
# ADMIN_BOOTSTRAP_TOKEN=replace-with-a-random-one-time-secret
JWT_TTL_SECONDS=900
LOG_LEVEL=info
# Select "openai" or "groq" as the primary provider.
LLM_PROVIDER=openai
# Optional. Set the selected provider's key locally; never commit real keys.
# OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=gpt-6-luna
# For Groq, set LLM_PROVIDER=groq and uncomment GROQ_API_KEY.
# GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b
# Optional fallbacks run in this order after the selected primary provider.
# A failed node sends its same prompt and project context to the next configured provider.
# GEMINI_API_KEY=replace-with-your-google-ai-studio-api-key
GEMINI_MODEL=gemini-4-hydrogen
# Mercury API access is scheduled to end after December 28, 2026.
# INCEPTION_API_KEY=replace-with-your-inception-api-key
INCEPTION_MODEL=mercury-3
PASSWORD_RESET_TTL_SECONDS=900
PASSWORD_RESET_FRONTEND_URL=http://localhost:5173/reset-password
EMAIL_PROVIDER=none
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=replace-with-smtp-user
# SMTP_PASS=replace-with-smtp-password
# EMAIL_FROM=noreply@example.com
# GOOGLE_CLIENT_ID=replace-with-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
# GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
# GOOGLE_FRONTEND_REDIRECT_URL=http://localhost:5173/auth/google/callback
